{
  "env": {
    "TEST_NUM": "1200000",
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/validate_docs.py:*)",
      "Bash(python scripts/validate_docs.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "context7",
    "serena"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__serena__serena_repl",
        "hooks": [
          {
            "type": "command",
            "command": "for PY in python3 python py; do if \"$PY\" -c \"\" >/dev/null 2>&1; then exec \"$PY\" \"$CLAUDE_PROJECT_DIR/scripts/block_serena_secrets.py\"; fi; done; echo \"Python 3 が見つからないため serena_repl の検査ができません。実行を拒否しました\" >&2; exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "for PY in python3 python py; do if \"$PY\" -c \"\" >/dev/null 2>&1; then exec \"$PY\" \"$CLAUDE_PROJECT_DIR/scripts/validate_docs.py\" --hook; fi; done; echo \"Python 3 が見つからないため docs の自動検証をスキップしました\" >&2; exit 1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
