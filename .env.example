# コピーして .env.local を作る（.env.local は git 管理しない）
# ローカル開発はファイル DB で動く。Turso に繋ぐときだけ下の2つを置き換える。
DATABASE_URL=file:./local.db
# DATABASE_URL=libsql://<db名>-<org名>.turso.io
# TURSO_AUTH_TOKEN=            # シークレット。Turso 接続時のみ

BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=          # シークレット。32文字以上: openssl rand -base64 32
NEXT_TELEMETRY_DISABLED=1
