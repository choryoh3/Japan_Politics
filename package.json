{
  "name": "japan-politics",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @japan-politics/web dev",
    "build": "pnpm --filter @japan-politics/web build",
    "start": "pnpm --filter @japan-politics/web start",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @japan-politics/db migrate",
    "db:seed": "pnpm --filter @japan-politics/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
